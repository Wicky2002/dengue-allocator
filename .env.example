# Copy to .env and edit. Nothing here is required for `make baseline`,
# which runs fully offline against the synthetic panel.

# --- ReliefWeb API ---------------------------------------------------------
# API v1 was decommissioned; v2 is current. From 1 Nov 2025 ReliefWeb requires a
# PRE-APPROVED appname. Request one at https://reliefweb.int/contact (subject
# "API appname"). Unapproved names may be rate-limited or rejected.
RELIEFWEB_APPNAME=dengue-allocator
RELIEFWEB_BASE_URL=https://api.reliefweb.int/v2

# --- Open-Meteo Archive ----------------------------------------------------
# No API key needed for the free non-commercial tier. Set a customer endpoint
# here only if you hold a commercial subscription.
OPENMETEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# --- Epidemiology Unit (Weekly Epidemiological Report) ----------------------
EPID_BASE_URL=https://www.epid.gov.lk

# --- CRAN mirror (colmozzie prototyping dataset) ---------------------------
CRAN_BASE_URL=https://cran.r-project.org

# --- runtime ---------------------------------------------------------------
# DENGUE_DATA_DIR overrides the default <repo>/data location.
# DENGUE_DATA_DIR=
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=60
